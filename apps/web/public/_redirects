# Stable, crawler-friendly legal URLs.
#
# Google's OAuth verification and app-store review expect a real URL, not a
# hash route. The build emits /privacy/index.html and /terms/index.html; these
# rules make the no-slash form resolve there too, so either form is safe to
# submit.
/privacy /privacy/ 301
/terms /terms/ 301
/privacy.html /privacy/ 301
/terms.html /terms/ 301

# The guide and the official collection are static pages with directory indexes.
# Older /banks/ URLs point at the single collection so old links still land.
/collections /collections/cpp-runoob/ 301
/collections/ /collections/cpp-runoob/ 301
/banks /collections/cpp-runoob/ 301
/banks/* /collections/cpp-runoob/ 301
/guide /guide/ 301

# Common sitemap typos should still reach the XML file. Submitting the bare
# domain, or robots.txt, is not a sitemap and Search Console reports it as HTML.
/sitemap /sitemap.xml 301
/sitemap.xml/ /sitemap.xml 301
/sitemap_index.xml /sitemap.xml 301
/sitemap-index.xml /sitemap.xml 301
