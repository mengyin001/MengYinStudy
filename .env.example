# ---------------------------------------------------------------------------
# MengYin Study — web client + backend tooling
#
# Only the *publishable* Supabase key belongs in a VITE_ variable. It is
# bundled into the browser app by design; row-level security does the real
# access control. Never put a secret key or DB password in a VITE_ variable.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://yukmxeieklwgnwdcqwpb.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_bl2gRxOO8EgNOQMlQR3dYQ_ZBbOvhaE

# How often the app checks the official catalogue for a new version.
VITE_OFFICIAL_SYNC_MINUTES=15

# ---------------------------------------------------------------------------
# Legal pages (Privacy Policy at /privacy/, Terms of Service at /terms/).
# The mailbox defaults to the address in apps/web/src/legal/config.ts; set it
# here only to publish a different one.
# ---------------------------------------------------------------------------
# Shown as the data controller in both documents.
VITE_LEGAL_OPERATOR=
# Support/privacy mailbox shown in both documents and used for deletion requests.
VITE_LEGAL_CONTACT_EMAIL=
# Public origin, used for the canonical URL in the standalone documents,
# e.g. https://mengyinstudy.example.workers.dev
VITE_PUBLIC_ORIGIN=

# Server-side tooling. These are read by tools/*.mjs, not by the browser.
SUPABASE_URL=https://yukmxeieklwgnwdcqwpb.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_bl2gRxOO8EgNOQMlQR3dYQ_ZBbOvhaE
SUPABASE_JWKS_URL=https://yukmxeieklwgnwdcqwpb.supabase.co/auth/v1/.well-known/jwks.json

# 'npm run seed:official' uses this. Keep it in .env.local, never in git.
SUPABASE_SECRET_KEY=

# 'npm run db:migrate' uses these (or SUPABASE_DB_URL). The runner percent-encodes
# SUPABASE_DB_PASSWORD; if you paste a complete SUPABASE_DB_URL, encode it yourself.
#
# Direct database hosts (db.<ref>.supabase.co) are IPv6-only on current
# projects. If your network has no IPv6 route, use the Session pooler string
# from Dashboard -> Connect instead — it is IPv4:
#
#   SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
#   SUPABASE_DB_PORT=5432
#   SUPABASE_DB_USER=postgres.<project-ref>
#
# The example below is this project's Seoul pooler.
SUPABASE_DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.yukmxeieklwgnwdcqwpb
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PASSWORD=
# SUPABASE_DB_URL=postgresql://postgres.<ref>:...@aws-0-<region>.pooler.supabase.com:5432/postgres
