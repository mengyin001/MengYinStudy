# ---------------------------------------------------------------------------
# MengYin Study — web client + backend tooling
#
# Only the *publishable* Supabase key belongs in a VITE_ variable. It is
# bundled into the browser app by design; row-level security does the real
# access control. Never put a secret key or DB password in a VITE_ variable.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://yukmxeieklwgnwdcqwpb.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_bl2gRxOO8EgNOQMlQR3dYQ_ZBbOvhaE

# How often the app checks the official catalogue for a new version.
VITE_OFFICIAL_SYNC_MINUTES=15

# ---------------------------------------------------------------------------
# Hosted AI question API
#
# Leave VITE_AI_API_BASE empty for the normal Worker deployment (same origin,
# `/api/ai`). The desktop shell or an external API host can set an absolute URL.
# `npm run dev` proxies /api to VITE_AI_API_PROXY (default 127.0.0.1:8787).
# ---------------------------------------------------------------------------
VITE_AI_API_BASE=
VITE_AI_API_PROXY=http://127.0.0.1:8787

# ---------------------------------------------------------------------------
# Legal pages (Privacy Policy at /privacy/, Terms of Service at /terms/).
# The mailbox defaults to the address in apps/web/src/legal/config.ts; set it
# here only to publish a different one.
# ---------------------------------------------------------------------------
# Shown as the data controller in both documents.
VITE_LEGAL_OPERATOR=
# Support/privacy mailbox shown in both documents and used for deletion requests.
VITE_LEGAL_CONTACT_EMAIL=
# Public origin, used for the canonical URL in the standalone documents,
# e.g. https://mengyinstudy.example.workers.dev
VITE_PUBLIC_ORIGIN=

# Server-side tooling. These are read by tools/*.mjs, not by the browser.
SUPABASE_URL=https://yukmxeieklwgnwdcqwpb.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_bl2gRxOO8EgNOQMlQR3dYQ_ZBbOvhaE
SUPABASE_JWKS_URL=https://yukmxeieklwgnwdcqwpb.supabase.co/auth/v1/.well-known/jwks.json

# ---------------------------------------------------------------------------
# AI providers for `npm run dev:api` (the local Node adapter).
#
# These are server-side only: never prefix them with VITE_. `wrangler dev` and
# the deployed Worker read `.dev.vars` / `wrangler secret put` instead; see
# .dev.vars.example. Set at least one text provider, or leave AI_MOCK=1 for the
# demo provider.
# ---------------------------------------------------------------------------
GLM_API_KEY=
GLM_MODEL=glm-4.7-flash
# GLM_MODELS=glm-4.7-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_MODELS=deepseek-flash,deepseek-v4-pro

# Images use the Cloudflare Workers AI free allocation. The local adapter
# honours AI_MOCK=1 and draws a placeholder SVG instead.
IMAGE_PROVIDER=cloudflare
IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Set IMAGE_PROVIDER=demo for local testing without a Cloudflare binding.
# AI_MOCK=1

# The local adapter defaults AUTH_REQUIRED=false. Production keeps it true.
# AUTH_REQUIRED=false

# 'npm run seed:official' uses this. Keep it in .env.local, never in git.
SUPABASE_SECRET_KEY=

# 'npm run db:migrate' uses these (or SUPABASE_DB_URL). The runner percent-encodes
# SUPABASE_DB_PASSWORD; if you paste a complete SUPABASE_DB_URL, encode it yourself.
#
# Direct database hosts (db.<ref>.supabase.co) are IPv6-only on current
# projects. If your network has no IPv6 route, use the Session pooler string
# from Dashboard -> Connect instead — it is IPv4:
#
#   SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
#   SUPABASE_DB_PORT=5432
#   SUPABASE_DB_USER=postgres.<project-ref>
#
# The example below is this project's Seoul pooler.
SUPABASE_DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.yukmxeieklwgnwdcqwpb
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PASSWORD=
# SUPABASE_DB_URL=postgresql://postgres.<ref>:...@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Billing (Stripe). See docs/STRIPE_SETUP.md and docs/SUBSCRIPTION_POINTS.md.
# ---------------------------------------------------------------------------
# Plan limits, the free 200-question quota and point charges are on by default;
# generation never trusts a client-side plan. Set "false" only for an off-line
# demo. Stripe checkout and the webhook need the secret key and one price id per
# plan. The free quota and refunds also need SUPABASE_SERVICE_KEY.
# BILLING_ENFORCE=true
# SUPABASE_SERVICE_KEY=      # defaults to SUPABASE_SECRET_KEY
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# One price id per paid plan and interval, created in the Stripe dashboard.
# Annual prices are supported: points are still granted every month even though
# Stripe invoices once a year. Set all six for a full launch; an unset price
# makes that plan/interval answer 503 when chosen. Full walkthrough:
# docs/STRIPE_SETUP.md.
# STRIPE_PRICE_LIGHT_MONTH=
# STRIPE_PRICE_LIGHT_YEAR=
# STRIPE_PRICE_STANDARD_MONTH=
# STRIPE_PRICE_STANDARD_YEAR=
# STRIPE_PRICE_PRO_MONTH=
# STRIPE_PRICE_PRO_YEAR=
# APP_URL=https://your-site.example
